const $=s=>document.querySelector(s);
let files=[],code='';
const MAX=5*1024**3,PART=50*1024*1024;
const fmt=n=>n>1e9?(n/1e9).toFixed(2)+' GB':n>1e6?(n/1e6).toFixed(1)+' MB':Math.ceil(n/1e3)+' KB';
/* theme */
const MOON='<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" filter="url(#rough)"><path d="M20 14.6A8.4 8.4 0 1 1 9.4 4a6.7 6.7 0 0 0 10.6 10.6z"/><path d="M20.6 15.1A8.4 8.4 0 1 1 10 4.6" opacity=".55"/><path d="M17 4.5v3M15.5 6h3" stroke-width="1.3"/><path d="M21 9.5v2" stroke-width="1.2"/></svg>';
const SUN='<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" filter="url(#rough)"><circle cx="12" cy="12" r="4.2"/><circle cx="12.5" cy="11.6" r="4.2" opacity=".5"/><path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>';
function theme(t){document.documentElement.dataset.theme=t;$('#mode').innerHTML=t==='dark'?SUN:MOON}
try{theme(localStorage.getItem('aos-theme')||'light')}catch(e){theme('light')}
$('#mode').onclick=()=>{const t=document.documentElement.dataset.theme==='dark'?'light':'dark';theme(t);try{localStorage.setItem('aos-theme',t)}catch(e){}};
/* tabs */
function tab(s){$('#send').classList.toggle('hide',!s);$('#recv').classList.toggle('hide',s);$('#tS').classList.toggle('on',s);$('#tR').classList.toggle('on',!s)}
$('#tS').onclick=()=>tab(true);$('#tR').onclick=()=>tab(false);
/* pick files */
function render(){$('#list').innerHTML=files.map(f=>`<div class="file"><span>📄 ${f.name.replace(/</g,'&lt;')}</span><span>${fmt(f.size)}</span></div>`).join('');$('#go').classList.toggle('hide',!files.length)}
function add(l){for(const f of l){if(f.size===0)continue;if(f.size>MAX){alert(f.name+' is larger than 5 GB');continue}files.push(f)}render()}
$('#drop').onclick=()=>$('#fi').click();
$('#fi').onchange=e=>{add(e.target.files);e.target.value=''};
$('#drop').ondragover=e=>{e.preventDefault();$('#drop').classList.add('over')};
$('#drop').ondragleave=()=>$('#drop').classList.remove('over');
$('#drop').ondrop=e=>{e.preventDefault();$('#drop').classList.remove('over');add(e.dataTransfer.files)};
/* upload */
function xhr(m,url,body,type,prog){return new Promise((ok,no)=>{const x=new XMLHttpRequest();x.open(m,url);if(type)x.setRequestHeader('Content-Type',type);if(prog)x.upload.onprogress=e=>prog(e.loaded);x.onload=()=>x.status===200?ok(JSON.parse(x.responseText)):no(new Error(x.responseText||x.status));x.onerror=()=>no(new Error('Network error'));x.send(body)})}
function prog(p){const v=Math.min(100,Math.round(p*100));$('#pb').style.width=v+'%';$('#pp').textContent=v+'%'}
function boxes(c){$('#cd').innerHTML='';[...c].forEach(ch=>{const d=document.createElement('div');d.textContent=ch;$('#cd').append(d)})}
$('#go').onclick=async()=>{
 $('#s1').classList.add('hide');$('#s2').classList.remove('hide');prog(0);
 try{
  const total=files.reduce((a,f)=>a+f.size,0);let done=0;
  const r=await (await fetch('/api/new',{method:'POST'})).json();
  if(!r.code)throw new Error(r.error||'failed');code=r.code;const c=encodeURIComponent(code);
  for(const f of files){
   $('#pt').textContent='Uploading '+f.name;
   const s=await xhr('POST',`/api/mpstart/${c}?name=${encodeURIComponent(f.name)}`,null,f.type||'application/octet-stream');
   const parts=[];
   for(let o=0,n=1;o<f.size;o+=PART,n++){
    const b=f.slice(o,o+PART),base=done;
    parts.push(await xhr('PUT',`/api/mppart/${c}?key=${encodeURIComponent(s.key)}&id=${encodeURIComponent(s.uploadId)}&n=${n}`,b,'application/octet-stream',l=>prog((base+l)/total)));
    done+=b.size;
   }
   await xhr('POST',`/api/mpend/${c}`,JSON.stringify({key:s.key,id:s.uploadId,parts}),'application/json');
  }
  boxes(code);$('#s2').classList.add('hide');$('#s3').classList.remove('hide');
 }catch(e){alert('Upload failed: '+e.message);$('#s2').classList.add('hide');$('#s1').classList.remove('hide')}
};
function copy(t,btn,label){try{navigator.clipboard.writeText(t)}catch(e){}btn.textContent='✓ Copied';setTimeout(()=>btn.textContent=label,1500)}
$('#cc').onclick=()=>copy(code,$('#cc'),'⧉ Copy code');
$('#cl').onclick=()=>copy(location.origin+'/?c='+encodeURIComponent(code),$('#cl'),'⧉ Copy link');
$('#again').onclick=()=>{files=[];code='';render();$('#s3').classList.add('hide');$('#s1').classList.remove('hide')};
/* receive */
const ins=[];
for(let i=0;i<6;i++){const el=document.createElement('input');el.maxLength=1;el.autocomplete='off';el.autocapitalize='characters';ins.push(el);$('#ci').append(el);
 el.oninput=()=>{el.value=el.value.toUpperCase();if(el.value&&i<5)ins[i+1].focus();chk()};
 el.onkeydown=e=>{if(e.key==='Backspace'&&!el.value&&i>0)ins[i-1].focus();if(e.key==='Enter')find()};
 el.onpaste=e=>{e.preventDefault();fill((e.clipboardData.getData('text')||'').trim())}}
function fill(t){[...t.toUpperCase()].slice(0,6).forEach((ch,i)=>ins[i].value=ch);chk()}
const val=()=>ins.map(i=>i.value).join('');
function chk(){$('#find').disabled=val().length<6}
async function find(){
 const c=val();if(c.length<6)return;
 $('#res').innerHTML='';$('#rp').textContent='Searching…';
 try{
  const r=await (await fetch('/api/list/'+encodeURIComponent(c))).json();
  if(!r.files||!r.files.length){$('#rp').textContent='No file found for this code.';return}
  $('#rp').textContent='';
  r.files.forEach(f=>{
   const row=document.createElement('div');row.className='file';
   const n=document.createElement('span');n.textContent='📄 '+f.name+' ('+fmt(f.size)+')';
   const a=document.createElement('a');a.href='/api/file/'+encodeURIComponent(c)+'?key='+encodeURIComponent(f.key);a.textContent='Download';a.style.cssText='color:var(--acc);font-weight:700;text-decoration:none';
   row.append(n,a);$('#res').append(row);
  });
 }catch(e){$('#rp').textContent='Error: '+e.message}
}
$('#find').onclick=find;
const q=new URLSearchParams(location.search).get('c');
if(q){tab(false);fill(q);find()}
